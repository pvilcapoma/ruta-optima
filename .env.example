# Clave de TomTom (gratis, sin tarjeta): https://developer.tomtom.com → registrarse → My Dashboard → Keys
# La clave por defecto ("My first API key") ya incluye Map Display, Routing, Search y Traffic.
VITE_TOMTOM_API_KEY=TU_CLAVE_AQUI

# Centro inicial del mapa (por defecto Lima, Perú)
VITE_DEFAULT_LAT=-12.0464
VITE_DEFAULT_LNG=-77.0428

# Códigos de país para acotar el buscador (separados por coma). Vacío = sin restricción.
VITE_REGION_CODES=pe
